# ==============================================================================
# TechnoAmaze SDLC Website - Git Ignore Rules
# ==============================================================================

# 1. Dependencies
node_modules/

# 2. Environment & Secrets
.env
.env.*
!.env.example
wp-env.override.json

# 3. Database Dumps & Backups
# Exclude database dumps, SQLite files, and backups, while preserving schema definition
*.sql
!data/schema.sql
*.sqlite
*.sqlite3
*.db
data/backups/

# 4. User Uploads & Media (Candidate Resumes, Uploaded Files)
uploads/

# 5. Logs & Temporary Test Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
debug.log
test_*.html
*.tmp
*.swp
*.bak

# 6. Operating System & Local Files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# 7. IDE / Editor Folders
.vscode/
.idea/